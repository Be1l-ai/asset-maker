#!/usr/bin/env bash
# Git commit-msg hook enforcing Conventional Commits specification.
# Format: <type>(<optional scope>): <description>

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

# Allow merge commits
if [[ "$commit_msg" =~ ^Merge ]]; then
    exit 0
fi

# Allow revert commits
if [[ "$commit_msg" =~ ^Revert ]]; then
    exit 0
fi

# Regex for Conventional Commits
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\.\/-]+\))?: .+$"

if ! [[ "$commit_msg" =~ $pattern ]]; then
    echo "❌ Invalid commit message format."
    echo ""
    echo "Commit message was: \"$commit_msg\""
    echo ""
    echo "Expected Conventional Commits format:"
    echo "  <type>(<scope>): <subject>"
    echo "  <type>: <subject>"
    echo ""
    echo "Allowed types:"
    echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    echo "Examples:"
    echo "  feat(pipeline): add MeshBuilder class for solid CSG booleans"
    echo "  fix(vfx): correct 1-pixel border gutter in sprite downsampling"
    echo "  docs(agents): document multi-harness skills discovery"
    echo "  chore(config): configure git hooks and conventional commits"
    exit 1
fi
